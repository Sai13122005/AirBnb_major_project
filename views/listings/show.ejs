<% layout("/layouts/boilerplate") %>
<body>
    <h2>Listing Details:-</h2>
        <ul>
            <img src="<%=data.image.url%>" width="400px">
            <li>Title: <%= data.title%></li>
            <li>Description:<%=data.description%></li>
            <% const price = data.price != null ? Number(data.price) : null; %>
            <li>Price: <%= price !== null && !Number.isNaN(price) ? `₹ ${price.toLocaleString("en-IN")}` : "Price not available" %></li>
            <li>Location: <%= data.location %></li>
            <li>Country: <%= data.country%></li>
        </ul>
        <form action="/listings/<%= data._id%>/edit" style="display: inline;">
            <button class="btn btn-secondary">Edit</button>
        </form>
         <form method="POST" action="/listings/<%=data._id%>?_method=DELETE">
            <br><button class="btn btn-danger">delete</button>
        </form>
</body>
