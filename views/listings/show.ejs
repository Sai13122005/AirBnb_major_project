<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h2>
                <%= data.title%>
            </h2>
        </div>
        <div class="card col-6 offset-3 listingCard">
            <img src="<%=data.image.url%>" class="card-img-top" alt="listing_image">
            <div class="card-boy">
                <p class="card-text">
                    <%=data.description%> <br>
                        <% const price=data.price !=null ? Number(data.price) : null; %>
                            Price: <%= price !==null && !Number.isNaN(price) ? `₹
                                ${price.toLocaleString("en-IN")}`: "Price not available" %> <br>
                                Location: <%= data.location %> <br>
                                    Country: <%= data.country%>
                </p>
            </div>
        </div>

        <div class="col-8 offset-3">
            <form action="/listings/<%= data._id%>/edit" style="display: inline;">
                <button class="btn btn-secondary">Edit</button>
            </form>
            <form method="POST" action="/listings/<%=data._id%>?_method=DELETE">
                <br><button class="btn btn-danger">delete</button>
            </form>
        </div>
        <div class="col-8 offset-3">
            <hr>
            <h4>Leave a Review</h4>
            <form novalidate class="mb-3 needs-validation" action="/listings/<%= data._id%>/reviews" method="POST">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea required name="review[comment]" id="comment" cols="30" rows="6"
                        class="form-control"></textarea>
                    <div class="invalid-feedback">Please add some comments</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>

            <hr>
            <p><b>All Reviews</b></p>
            <div class="row">
                <% for(review of data.reviews) {%>
                    <div class="card mb-3 col-5 ms-3">
                        <div class="card-body mt-3">
                            <h5 class="card-title">Reviewer Name</h5>
                            <p class="card-text">Comment: <%= review.comment %> <br> Rating: <%= review.rating %>
                            </p>
                            <form method="post" action="/listings/<%= data._id %>/reviews/<%=review._id%>?_method=DELETE" >
                                <button class="btn btn-sm btn-danger mb-3">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
    </div>