<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h2>Enter your place Details</h2>
    <form action="/listings" method="post">
        <input type="text" name="listing[title]" placeholder="Enter place title">
        <br>
        <textarea name="listing[description]" placeholder="Enter place description"></textarea>
        <br>
        <input type="number" name="listing[price]" placeholder="Enter place price">
        <br>
        <input type="text" name="listing[image]" placeholder="Enter image url">
        <br>
        <input type="text" name="listing[location]" placeholder="Enter location">
        <br>
        <input type="text" name="listing[country]" placeholder="Enter country">
        <br>
        <button>add</button>
    </form>
</body>
</html>