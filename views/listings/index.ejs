<% layout("/layouts/boilerplate") %>
<body>

    <h1>All Listing</h1>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let listing of allList) {%>
            <a href="/listings/<%= listing._id%>" class="card-listing-link">
                <div class="card col listingCard">
                    <img src="<%= listing.image.url%>" class="card-img-top" alt="listing-image" style="height: 20rem;">
                    <div class="card-img-overlay">  </div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br>
                            <% const price = listing.price != null ? Number(listing.price) : null; %>
                            <%= price !== null && !Number.isNaN(price) ? `₹${price.toLocaleString("en-IN")}/night` : "Price not available" %>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
    
</body>